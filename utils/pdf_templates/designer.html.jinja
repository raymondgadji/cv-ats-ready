<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<style>
  @import url('https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=DM+Sans:wght@400;500;600&display=swap');

  @page {
    size: A4;
    margin: 14mm 0 16mm 0;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    font-family: 'DM Sans', sans-serif;
    color: {{ dark_text }};
    font-size: 9.5pt;
  }

  /* En-tête (identité + photo + formes décoratives) : seule partie encore positionnée librement
     par bloc, en mm absolus (calculés côté Python) pour ne pas dépendre de la hauteur du
     conteneur — voir la note "Pourquoi un flux normal" plus bas. */
  .header-canvas {
    position: relative;
    width: 210mm;
    background: #ffffff;
  }
  .block {
    position: absolute;
    overflow: hidden;
    padding: 10px 12px;
  }
  .block.shape-circle {
    border-radius: 50%;
    padding: 0;
  }

  .id-name {
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    font-size: 20pt;
    color: {{ dark_text }};
    line-height: 1.1;
  }
  .id-contact {
    margin-top: 6px;
    font-size: 8.5pt;
    color: {{ text_muted }};
  }
  .photo-fill {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .photo-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: {{ accent_light_strong }};
    color: {{ accent_color }};
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    font-size: 22pt;
  }

  /* Pourquoi un flux normal (pas des blocs positionnés en absolu) pour le corps du CV :
     Profil/Compétences/Formation/Expérience sont de longueur très variable d'un candidat à
     l'autre. Des blocs à taille fixe forçaient soit une troncature silencieuse du contenu, soit
     un découpage d'une même section entre des pages non-adjacentes (confus à la lecture, retour
     explicite de Raymond le 17/10/2026). Un flux normal laisse WeasyPrint paginer nativement :
     chaque section est entière avant de passer à la suivante, sur autant de pages que nécessaire. */
  .flow {
    padding: 0 16mm;
  }
  .flow-section {
    margin-bottom: 16px;
    break-inside: avoid;
    page-break-inside: avoid;
  }
  .flow-section h2 {
    font-family: 'Syne', sans-serif;
    font-size: 11pt;
    font-weight: 700;
    color: {{ accent_color }};
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin: 0 0 8px;
    padding-bottom: 5px;
    border-bottom: 1px solid rgba(0,0,0,0.1);
  }
  .flow-section p {
    margin: 0 0 8px;
    line-height: 1.55;
  }
  .flow-section p.entry-title {
    font-weight: 700;
    margin: 12px 0 4px;
  }
  .flow-section p.entry-title:first-child { margin-top: 0; }
  .flow-section ul.bullet-list {
    margin: 0 0 6px;
    padding-left: 18px;
  }
  .flow-section ul.bullet-list li {
    line-height: 1.55;
    margin-bottom: 3px;
  }
  .pill-row {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
  }
  .pill {
    background: {{ accent_light }};
    border-radius: 5px;
    padding: 5px 10px;
    font-size: 9pt;
    line-height: 1.3;
  }

  .footer {
    position: fixed;
    bottom: 6mm;
    left: 0;
    right: 0;
    text-align: center;
    font-size: 7.5pt;
    color: {{ text_muted }};
  }

  .cover-letter {
    background: #ffffff;
    color: {{ dark_text }};
    padding: 30px 34px;
  }
  .cover-letter h2 {
    font-family: 'Syne', sans-serif;
    font-size: 13pt;
    font-weight: 700;
    color: {{ accent_color }};
    margin: 0 0 14px;
  }
  .cover-letter p {
    margin: 0 0 10px;
    font-size: 10pt;
    line-height: 1.65;
    text-align: justify;
  }
</style>
</head>
<body>

  <div class="footer">CV généré par CV-ATS.COM</div>

  <div class="header-canvas" style="height:{{ header_height_mm }}mm;">
    {% for b in header_blocks %}
    <div class="block {% if b.shape == 'circle' %}shape-circle{% endif %}"
         style="left:{{ b.x_mm }}mm; top:{{ b.y_mm }}mm; width:{{ b.w_mm }}mm; height:{{ b.h_mm }}mm;">
      {% if b.type == 'identite' %}
        <div class="id-name">{{ name }}</div>
        {% if contact_lines %}
        <div class="id-contact">{{ contact_lines | join(' &nbsp;·&nbsp; ') }}</div>
        {% endif %}
      {% elif b.type == 'photo' %}
        {% if b.photo %}
        <img class="photo-fill" src="{{ b.photo }}" />
        {% else %}
        <div class="photo-placeholder">{{ (name[0] if name else '?') | upper }}</div>
        {% endif %}
      {% elif b.type == 'forme' %}
        {% if b.photo %}
        <img class="photo-fill" src="{{ b.photo }}" />
        {% else %}
        <div style="width:100%; height:100%; background:{{ b.bgColor or accent_color }};"></div>
        {% endif %}
      {% endif %}
    </div>
    {% endfor %}
  </div>

  <div class="flow">
    {% if profil %}
    <div class="flow-section">
      <h2>Profil</h2>
      {% for line in profil %}<p>{{ line }}</p>{% endfor %}
    </div>
    {% endif %}

    {% if competences %}
    <div class="flow-section">
      <h2>Compétences</h2>
      <div class="pill-row">
        {% for line in competences %}<div class="pill">{{ line }}</div>{% endfor %}
      </div>
    </div>
    {% endif %}

    {% if formation %}
    <div class="flow-section">
      <h2>Formation</h2>
      <div class="pill-row">
        {% for line in formation %}<div class="pill">{{ line }}</div>{% endfor %}
      </div>
    </div>
    {% endif %}

    {% if experience %}
    <div class="flow-section">
      <h2>Expérience</h2>
      {% for line in experience %}
        {%- if line.startswith('- ') %}
        <ul class="bullet-list"><li>{{ line[2:] }}</li></ul>
        {%- else %}
        <p class="entry-title">{{ line }}</p>
        {%- endif %}
      {% endfor %}
    </div>
    {% endif %}

    {% if autres %}
    <div class="flow-section">
      <h2>Autres</h2>
      {% for line in autres %}<p>{{ line }}</p>{% endfor %}
    </div>
    {% endif %}
  </div>

  {% if cover_letter_lines %}
  <div class="cover-letter" style="page-break-before: always;">
    <h2>Lettre de motivation</h2>
    {% for line in cover_letter_lines %}
    <p>{{ line }}</p>
    {% endfor %}
  </div>
  {% endif %}

</body>
</html>
