<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<style>
  @import url('https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=DM+Sans:wght@400;500;600&display=swap');

  @page {
    size: A4;
    margin: 0;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    font-family: 'DM Sans', sans-serif;
    color: {{ dark_text }};
    font-size: 9.5pt;
  }

  .page {
    position: relative;
    width: 210mm;
    height: 297mm;
    background: #ffffff;
    overflow: hidden;
  }

  .block {
    position: absolute;
    overflow: hidden;
    padding: 10px 12px;
  }
  .block.shape-circle {
    border-radius: 50%;
    padding: 0;
  }

  .block h2 {
    font-family: 'Syne', sans-serif;
    font-size: 10.5pt;
    font-weight: 700;
    color: {{ accent_color }};
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin: 0 0 8px;
    padding-bottom: 5px;
    border-bottom: 1px solid rgba(0,0,0,0.1);
  }
  .block p {
    margin: 0 0 6px;
    line-height: 1.5;
  }

  .id-name {
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    font-size: 20pt;
    color: {{ dark_text }};
    line-height: 1.1;
  }
  .id-contact {
    margin-top: 6px;
    font-size: 8.5pt;
    color: {{ text_muted }};
  }

  .pill {
    display: block;
    background: {{ accent_light }};
    border-radius: 5px;
    padding: 5px 9px;
    margin-bottom: 6px;
    font-size: 8.5pt;
    line-height: 1.3;
  }

  .photo-fill {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .photo-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: {{ accent_light_strong }};
    color: {{ accent_color }};
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    font-size: 22pt;
  }

  .footer {
    position: absolute;
    bottom: 6mm;
    left: 0;
    right: 0;
    text-align: center;
    font-size: 7.5pt;
    color: {{ text_muted }};
  }

  .cover-letter {
    background: #ffffff;
    color: {{ dark_text }};
    padding: 30px 34px;
  }
  .cover-letter h2 {
    font-family: 'Syne', sans-serif;
    font-size: 13pt;
    font-weight: 700;
    color: {{ accent_color }};
    margin: 0 0 14px;
  }
  .cover-letter p {
    margin: 0 0 10px;
    font-size: 10pt;
    line-height: 1.65;
    text-align: justify;
  }
</style>
</head>
<body>

  <div class="page">
    {% for b in blocks %}
    <div class="block {% if b.shape == 'circle' %}shape-circle{% endif %}"
         style="left:{{ b.x }}%; top:{{ b.y }}%; width:{{ b.w }}%; height:{{ b.h }}%;">

      {% if b.type == 'identite' %}
        <div class="id-name">{{ name }}</div>
        {% if contact_lines %}
        <div class="id-contact">{{ contact_lines | join(' &nbsp;·&nbsp; ') }}</div>
        {% endif %}

      {% elif b.type == 'photo' %}
        {% if b.photo %}
        <img class="photo-fill" src="{{ b.photo }}" />
        {% else %}
        <div class="photo-placeholder">{{ (name[0] if name else '?') | upper }}</div>
        {% endif %}

      {% elif b.type == 'competences' %}
        <h2 style="color:{{ b.color or accent_color }};">Compétences</h2>
        {% for line in competences %}
        <div class="pill" style="background:{{ b.color_light or accent_light }};">{{ line }}</div>
        {% endfor %}

      {% elif b.type == 'formation' %}
        <h2 style="color:{{ b.color or accent_color }};">Formation</h2>
        {% for line in formation %}
        <div class="pill" style="background:{{ b.color_light or accent_light }};">{{ line }}</div>
        {% endfor %}

      {% elif b.type == 'experience' %}
        <h2 style="color:{{ b.color or accent_color }};">Expérience</h2>
        {% for line in experience %}
        <p>{{ line }}</p>
        {% endfor %}

      {% elif b.type == 'autres' %}
        <h2 style="color:{{ b.color or accent_color }};">Autres</h2>
        {% for line in autres %}
        <p>{{ line }}</p>
        {% endfor %}

      {% elif b.type == 'forme' %}
        {% if b.photo %}
        <img class="photo-fill" src="{{ b.photo }}" />
        {% else %}
        <div style="width:100%; height:100%; background:{{ b.color or accent_color }};"></div>
        {% endif %}
      {% endif %}
    </div>
    {% endfor %}

    <div class="footer">CV généré par CV-ATS.COM</div>
  </div>

  {% if cover_letter_lines %}
  <div class="cover-letter" style="page-break-before: always;">
    <h2>Lettre de motivation</h2>
    {% for line in cover_letter_lines %}
    <p>{{ line }}</p>
    {% endfor %}
  </div>
  {% endif %}

</body>
</html>
